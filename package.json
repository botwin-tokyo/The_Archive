{
  "name": "the-archive",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "desktop": "electron .",
    "build": "vite build --config apps/desktop/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:arm64": "npm run build && node scripts/package-desktop.mjs arm64",
    "package:linux": "npm run build && node scripts/package-desktop.mjs",
    "test:native": "playwright test --config playwright.native.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "test:backend": "PYTHONPATH=apps/backend/src python3 -m unittest discover -s apps/backend/tests -v",
    "check:backend": "python3 scripts/check-backend.py && npm run test:backend",
    "check:all": "npm run check && npm run check:backend",
    "package:backend": "python3 scripts/package-backend.py",
    "desktop:demo": "ARCHIVE_CONSOLE_MODE=demo electron ."
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "eslint": "9.39.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "productName": "The Archive",
  "author": ""
}
