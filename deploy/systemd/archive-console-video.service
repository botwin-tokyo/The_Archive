[Unit]
Description=The Archive isolated video worker
After=network-online.target archive-video-egress.service
Requires=archive-video-egress.service
Wants=network-online.target
RequiresMountsFor=@RUNTIME_ROOT@

[Service]
Type=simple
User=archive-video
Group=archive-video-read
Environment=HOME=@RUNTIME_ROOT@/archive-console-video/home
Environment=PYTHONPATH=@RUNTIME_ROOT@/archive-console-video/current/src
Environment=PATH=@RUNTIME_ROOT@/archive-console-video/current/venv/bin:@RUNTIME_ROOT@/archive-console-video/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=@RUNTIME_ROOT@/archive-console-video/home
ExecStart=@RUNTIME_ROOT@/archive-console-video/current/venv/bin/python -m archive_video_worker /etc/archive-console/video-worker.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
RuntimeDirectory=archive-console-video
RuntimeDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ReadWritePaths=@RUNTIME_ROOT@/archive-console-video/spool @RUNTIME_ROOT@/archive-console-video/home
InaccessiblePaths=@FILES_MOUNT@ @BACKUPS_MOUNT@ @RUNTIME_ROOT@/archive-console-service /etc/archive-console/config.json /home
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
LimitFSIZE=8589934592

[Install]
WantedBy=multi-user.target
