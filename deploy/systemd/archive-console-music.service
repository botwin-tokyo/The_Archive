[Unit]
Description=The Archive isolated spotDL worker
After=network-online.target archive-music-egress.service
Requires=archive-music-egress.service
Wants=network-online.target
RequiresMountsFor=@RUNTIME_ROOT@

[Service]
Type=simple
User=archive-music
Group=archive-music-read
Environment=HOME=@RUNTIME_ROOT@/archive-console-music/home
Environment=PYTHONPATH=@RUNTIME_ROOT@/archive-console-music/current/src
Environment=PATH=@RUNTIME_ROOT@/archive-console-music/current/venv/bin:@RUNTIME_ROOT@/archive-console-music/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=@RUNTIME_ROOT@/archive-console-music/home
ExecStart=@RUNTIME_ROOT@/archive-console-music/current/venv/bin/python -m archive_music_worker /etc/archive-console/music-worker.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
RuntimeDirectory=archive-console-music
RuntimeDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ReadWritePaths=@RUNTIME_ROOT@/archive-console-music/spool @RUNTIME_ROOT@/archive-console-music/home
InaccessiblePaths=@FILES_MOUNT@ @BACKUPS_MOUNT@ @RUNTIME_ROOT@/archive-console-service /etc/archive-console/config.json /home
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
LimitFSIZE=536870912

[Install]
WantedBy=multi-user.target
