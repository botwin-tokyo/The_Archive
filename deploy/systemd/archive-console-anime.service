[Unit]
Description=The Archive isolated anime worker
After=network-online.target archive-anime-egress.service
Requires=archive-anime-egress.service
Wants=network-online.target
RequiresMountsFor=@RUNTIME_ROOT@

[Service]
Type=simple
User=archive-anime
Group=archive-anime-read
Environment=HOME=@RUNTIME_ROOT@/archive-console-anime/home
Environment=PYTHONPATH=@RUNTIME_ROOT@/archive-console-anime/current/src
Environment=PATH=/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=@RUNTIME_ROOT@/archive-console-anime/home
# Standard library only; FFmpeg/ffprobe come from the OS packages.
ExecStart=/usr/bin/python3 -m archive_anime_worker /etc/archive-console/anime-worker.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
RuntimeDirectory=archive-console-anime
RuntimeDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=@RUNTIME_ROOT@/archive-console-anime/spool @RUNTIME_ROOT@/archive-console-anime/home
# The installer replaces ANIME_INACCESSIBLE with every configured archive volume mount.
InaccessiblePaths=ANIME_INACCESSIBLE -@RUNTIME_ROOT@/archive-console-service -@RUNTIME_ROOT@/archive-console-music -@RUNTIME_ROOT@/archive-console-video -@RUNTIME_ROOT@/archive-console-git -/etc/archive-console/config.json -/home
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
LimitFSIZE=7516192768

[Install]
WantedBy=multi-user.target
