# Optional desktop mode: empty defaults to unconfigured service; use demo for synthetic data.
ARCHIVE_CONSOLE_MODE=
# Loopback backend HTTP origin. Leave blank until the backend is configured.
ARCHIVE_SERVICE_ENDPOINT=
# Private owner credential file (preferred); never put the credential file in this repository.
ARCHIVE_SERVICE_TOKEN_FILE=
# Alternative direct bearer credential; leave blank when using a token file.
ARCHIVE_SERVICE_TOKEN=
# Optional private deployment settings path; defaults to deploy/local.json.
ARCHIVE_DEPLOYMENT_CONFIG=
# Optional anime worker spool directory; normally set by its service process.
ARCHIVE_ANIME_SPOOL=
# Git worker credential file path; normally provided by the worker, never a token value.
ARCHIVE_GIT_SECRET=
# Optional Chromium executable for local browser smoke tests.
CHROMIUM_PATH=
# Optional packaged Electron executable for local native smoke tests.
ARCHIVE_PACKAGED_BINARY=
# Optional reproducible backend archive timestamp (integer Unix seconds).
SOURCE_DATE_EPOCH=
# Optional Electron distribution cache used when packaging.
electron_config_cache=
# This file is a reference; Electron/Python do not automatically load .env.
# Export only the values needed for your command. Do not export empty SOURCE_DATE_EPOCH.
